+        .parent_thread
+        .session
+        .input_queue
+        .subscribe_join_continuations();
+    let revision = *parent_revisions.borrow_and_update();
+    assert_eq!(
+        fixture
+            .parent_thread
+            .session
+            .input_queue
+            .join_owner_turn_for_generation(fixture.parent_thread_id, 1)
+            .await,
+        Ok(Some("A0".into()))

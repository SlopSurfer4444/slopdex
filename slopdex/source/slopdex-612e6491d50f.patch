+    release_b1.notify_one();
+    timeout(Duration::from_secs(2), async {
+        while fixture
+            .target_thread
+            .session
+            .active_turn
+            .lock()
+            .await
+            .is_some()
+        {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("B1 should complete and become idle");
+    timeout(Duration::from_secs(2), async {
+        while !fixture
+            .parent_thread
+            .session
+            .input_queue
+            .has_pending_mailbox_items()
+            .await
+        {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await

-        op: Op,
-        trace: Option<W3cTraceContext>,
-        parent_turn_id: Option<String>,
-        root_turn_id: Option<String>,
-    ) -> CodexResult<String> {
-        let id = new_submission_id();
-        let sub = Submission {
-            id: id.clone(),

+        recovery_error.details(),
+        CodexErrorDetails::AgentLimitReached { max_threads: 1 }
+    ));
+    assert_eq!(session.thread_settings_snapshot().await, settings_before);
+    assert!(session.active_turn.lock().await.is_none());
+    drop(held);

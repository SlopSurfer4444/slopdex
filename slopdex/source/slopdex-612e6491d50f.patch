+    let contents = doc.to_string();
+
+    // Assert exact output after conversion to explicit table
+    let expected = format!(
+        r#"[projects]
+
+[projects.{path_str}]
+trust_level = "trusted"
+"#
+    );
+    assert_eq!(contents, expected);
+
+    Ok(())

+                resolved,
+            )
+            .await;
+        }
+        Err(err) => {
+            let event = Event {
+                id: sub_id,
+                msg: EventMsg::Error(ErrorEvent {
+                    misalignment: None,
+                    message: err.to_string(),
+                    codex_error_info: Some(CodexErrorInfo::Other),
+                }),
+            };
+            sess.send_event(&turn_context, event.msg).await;
+        }
+    }
